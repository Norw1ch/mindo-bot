# Образец настроек. Скопируй этот файл в .env и впиши свои значения.

# Токен бота. Получить: в Telegram написать @BotFather -> /newbot
BOT_TOKEN=123456789:AAAA-ваш-токен

# Твой Telegram ID (только цифры). Узнать: написать @userinfobot
# Бот отвечает только этому пользователю, остальных игнорирует.
OWNER_ID=123456789

# Адрес опубликованного приложения (GitHub Pages), обязательно https://
# Пример: https://твой-логин.github.io/mindo-bot/
WEBAPP_URL=
